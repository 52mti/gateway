# Must match the upstream API JWT_SECRET.
JWT_SECRET=dev-jwt-secret-change-me

# Normal-user rate limit (requests per minute). VIP is not limited here.
KONG_NORMAL_RATE_LIMIT_PER_MINUTE=60

# Upstream FastAPI. Docker compose of nexus-law publishes the API on 18000.
# Local uvicorn on port 8000: set this to http://host.docker.internal:8000
# and move KONG_PROXY_PORT off 8000 so the two processes do not collide.
UPSTREAM_URL=http://host.docker.internal:18000

KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
